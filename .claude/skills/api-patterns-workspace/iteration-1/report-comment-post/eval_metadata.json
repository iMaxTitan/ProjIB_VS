{
  "eval_id": 1,
  "eval_name": "report-comment-post",
  "prompt": "Добавь POST endpoint `/api/reports/comment` для сохранения комментария к отчёту. Body: `{ reportId, text }`. Таблица: `report_comments`",
  "assertions": [
    { "name": "uses-isRequestAuthorized", "type": "contains", "value": "isRequestAuthorized(req)" },
    { "name": "uses-checkRateLimit", "type": "contains", "value": "checkRateLimit" },
    { "name": "uses-getDbUserId", "type": "contains", "value": "getDbUserId(req)" },
    { "name": "uses-getServerDb", "type": "contains", "value": "getServerDb()" },
    { "name": "validates-body", "type": "regex", "value": "reportId|text" },
    { "name": "post-rate-limit-10", "type": "regex", "value": "RATE_LIMIT\\s*=\\s*10" },
    { "name": "uses-logger", "type": "contains", "value": "logger.error" },
    { "name": "no-console-log", "type": "not_contains", "value": "console.log" },
    { "name": "cookie-userId-in-insert", "type": "regex", "value": "user_id.*userId|userId.*user_id" }
  ]
}
