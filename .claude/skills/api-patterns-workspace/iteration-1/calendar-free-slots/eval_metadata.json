{
  "eval_id": 2,
  "eval_name": "calendar-free-slots",
  "prompt": "Сделай API route POST `/api/calendar/free-slots` который через Graph API получает свободные слоты календаря пользователя за неделю и возвращает их",
  "assertions": [
    { "name": "uses-isRequestAuthorized", "type": "contains", "value": "isRequestAuthorized(req)" },
    { "name": "uses-checkRateLimit", "type": "contains", "value": "checkRateLimit" },
    { "name": "uses-getDbUserId", "type": "contains", "value": "getDbUserId(req)" },
    { "name": "uses-logger", "type": "contains", "value": "logger.error" },
    { "name": "no-console-log", "type": "not_contains", "value": "console.log" },
    { "name": "graph-api-call", "type": "regex", "value": "graph\\.microsoft\\.com|Graph|graph" },
    { "name": "returns-401", "type": "contains", "value": "401" },
    { "name": "returns-429", "type": "contains", "value": "429" }
  ]
}
