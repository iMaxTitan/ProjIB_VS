      ],
      "id": "0b8d3e56-718c-4262-acec-1b552e1452c0",
      "name": "getListChats",
      "credentials": {
        "microsoftTeamsOAuth2Api": {
          "id": "Xv7bVTA0d2sRsd2m",
          "name": "Microsoft Teams account"
        }
      }
    },
    {
      "parameters": {
        "name": "getChatID",
        "jsCode": "const chatNameOrUsers = $json.chatNameOrUsers.toLowerCase();\nconst chats = $json.value;\n\nlet chatFound = chats.find(c => c.topic && c.topic.toLowerCase() === chatNameOrUsers);\n\nif (!chatFound) {\n    chatFound = chats.find(c => c.members.some(user => \n        chatNameOrUsers.includes(user.displayName.toLowerCase())\n    ));\n}\n\nreturn chatFound ? [{ chatId: chatFound.id }] : [];"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
